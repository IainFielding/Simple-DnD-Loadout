{{!--
  The paper doll itself. Rendered by both surfaces — the sheet tab (sheet-tab.hbs) and the docked
  window (dock.hbs) — from scripts/doll/context.mjs#buildDollContext, and bound by
  scripts/doll/controller.mjs. Registered as the "sogrom-pd-doll" partial in main.mjs.

  Nothing in here decides what goes where; it only draws the resolved layout. Interaction hooks
  are `data-pd-*` attributes rather than dnd5e's `data-item-id`, so the sheet's own item context
  menus and drag handlers never mistake a slot for an inventory row.
--}}
<div class="sogrom-doll pd-surface-{{surface}} {{#if ember}}sogrom-ember{{/if}} {{#unless editable}}is-readonly{{/unless}}"
     data-pd-actor="{{actorUuid}}">

  <div class="pd-stage">
    <figure class="pd-portrait {{#if portrait.placeholder}}is-placeholder{{/if}}" aria-hidden="true">
      <img src="{{portrait.src}}" alt="" draggable="false"
           style="object-fit: {{portrait.fit}}; object-position: 50% {{portrait.focus}}%;">
      <div class="pd-vignette"></div>
    </figure>

    {{#if showName}}
    <header class="pd-nameplate">
      <h2 class="pd-name">{{name}}</h2>
    </header>
    {{/if}}

    {{#if editable}}
    <button type="button" class="pd-portrait-config" data-pd-action="portrait"
            data-tooltip="{{localize "sogrom-simple-dnd5e-paper-doll.portrait.configure"}}"
            aria-label="{{localize "sogrom-simple-dnd5e-paper-doll.portrait.configure"}}">
      <i class="fa-solid fa-image-portrait" inert></i>
    </button>
    {{/if}}

    <div class="pd-column pd-column--left" role="group">
      {{#each groups.left}}{{> sogrom-pd-slot}}{{/each}}
    </div>

    <div class="pd-column pd-column--right" role="group">
      {{#each groups.right}}{{> sogrom-pd-slot}}{{/each}}
    </div>

    <div class="pd-hands" role="group">
      {{#each groups.hands}}{{> sogrom-pd-slot}}{{/each}}
    </div>

    <div class="pd-picker-host"></div>
  </div>

  {{#if groups.trinkets.length}}
  <div class="pd-trinkets" role="group" aria-label="{{localize "sogrom-simple-dnd5e-paper-doll.slot.kind.trinket"}}">
    {{#each groups.trinkets}}{{> sogrom-pd-slot}}{{/each}}
  </div>
  {{/if}}

  {{#if unslotted.length}}
  <section class="pd-unslotted">
    <h3 class="pd-subhead" data-tooltip="{{localize "sogrom-simple-dnd5e-paper-doll.unslotted.hint"}}">
      {{localize "sogrom-simple-dnd5e-paper-doll.unslotted.title"}}
      <i class="fa-solid fa-circle-info" inert></i>
    </h3>
    <ul class="pd-chips">
      {{#each unslotted}}
      <li>
        <button type="button" class="pd-chip rarity-{{rarity}}" data-pd-unslotted="{{id}}" data-pd-uuid="{{uuid}}"
                {{#if draggable}}draggable="true"{{/if}}
                data-tooltip="{{tooltip}}" data-tooltip-class="{{tooltipClass}}" aria-label="{{name}}">
          <img src="{{img}}" alt="" draggable="false">
          <span>{{name}}</span>
        </button>
      </li>
      {{/each}}
    </ul>
  </section>
  {{/if}}

  <footer class="pd-stats">
    {{#if stats.ac includeZero=true}}
    <div class="pd-stat pd-stat--ac" data-tooltip="{{localize "sogrom-simple-dnd5e-paper-doll.stats.ac"}}">
      <i class="fa-solid fa-shield-halved" inert></i>
      <span class="pd-stat-value">{{stats.ac}}</span>
      <span class="pd-visually-hidden">{{localize "sogrom-simple-dnd5e-paper-doll.stats.ac"}}</span>
    </div>
    {{/if}}

    {{#if stats.attunement.pips.length}}
    <div class="pd-stat pd-stat--attunement {{#if stats.attunement.over}}is-over{{/if}}"
         data-tooltip="{{#if stats.attunement.over}}{{stats.attunement.overLabel}}{{else}}{{stats.attunement.label}}{{/if}}">
      <span class="pd-pips" aria-label="{{stats.attunement.label}}">
        {{#each stats.attunement.pips}}
        <span class="pd-pip {{#if filled}}is-filled{{/if}} {{#if over}}is-over{{/if}}"></span>
        {{/each}}
      </span>
    </div>
    {{/if}}

    {{#if stats.encumbrance}}
    <div class="pd-stat pd-stat--encumbrance band-{{stats.encumbrance.band}}"
         data-tooltip="{{localize "sogrom-simple-dnd5e-paper-doll.stats.encumbrance"}}: {{stats.encumbrance.label}}">
      <i class="fa-solid fa-weight-hanging" inert></i>
      <span class="pd-bar" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{stats.encumbrance.pct}}"
            aria-label="{{localize "sogrom-simple-dnd5e-paper-doll.stats.encumbrance"}}">
        <span class="pd-bar-fill" style="width: {{stats.encumbrance.pct}}%"></span>
      </span>
      <span class="pd-stat-value pd-stat-value--small">{{stats.encumbrance.label}}</span>
    </div>
    {{/if}}
  </footer>
</div>
