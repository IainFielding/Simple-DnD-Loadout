{{!--
  One slot. Registered as the "sogrom-pd-slot" partial; the context is a dressed cell from
  scripts/doll/context.mjs#dressCell.

  A <button> so every slot is reachable and operable from the keyboard: Enter opens the picker or
  the item, the context-menu key opens the slot menu, Delete takes the item off.
--}}
<button type="button"
        class="pd-slot pd-slot--{{kind}} {{#if item}}is-filled rarity-{{item.rarity}}{{else}}is-empty{{/if}} {{#if blocked}}is-blocked{{/if}} {{#if conflict}}is-conflict{{/if}} {{#if item.inert}}is-inert{{/if}}"
        data-pd-slot="{{key}}" data-pd-kind="{{kind}}" data-pd-group="{{group}}"
        {{#if item}}data-pd-item="{{item.id}}" data-pd-uuid="{{item.uuid}}" {{#if draggable}}draggable="true"{{/if}}{{/if}}
        data-tooltip="{{tooltip}}" {{#if tooltipClass}}data-tooltip-class="{{tooltipClass}}"{{/if}}
        aria-label="{{ariaLabel}}">
  {{#if item}}
  <img class="pd-slot-img" src="{{item.img}}" alt="" draggable="false">
  {{else if ghost}}
  <img class="pd-slot-img pd-slot-img--ghost" src="{{ghost}}" alt="" draggable="false">
  <i class="pd-slot-lock fa-solid fa-link" inert></i>
  {{else}}
  <img class="pd-slot-img pd-slot-img--placeholder" src="{{placeholder}}" alt="" draggable="false">
  {{/if}}

  {{#if item.attuned}}
  <i class="pd-badge pd-badge--attuned fa-solid fa-sun" inert></i>
  {{else if item.inert}}
  <i class="pd-badge pd-badge--inert fa-regular fa-sun" inert></i>
  {{/if}}
  {{#if conflict}}
  <i class="pd-badge pd-badge--conflict fa-solid fa-triangle-exclamation" inert></i>
  {{/if}}

  <span class="pd-slot-label" aria-hidden="true">{{label}}</span>
</button>
