{{!--
  The loadout itself. Rendered by both surfaces — the sheet tab (sheet-tab.hbs) and the docked
  window (dock.hbs) — from scripts/loadout/context.mjs#buildLoadoutContext, and bound by
  scripts/loadout/controller.mjs. Registered as the "sogrom-lo-loadout" partial in main.mjs.

  Nothing in here decides what goes where; it only draws the resolved layout. Interaction hooks
  are `data-lo-*` attributes rather than dnd5e's `data-item-id`, so the sheet's own item context
  menus and drag handlers never mistake a slot for an inventory row.
--}}
<div class="sogrom-loadout lo-surface-{{surface}} {{#if ember}}sogrom-ember{{/if}} {{#unless editable}}is-readonly{{/unless}}"
     data-lo-actor="{{actorUuid}}">

  <div class="lo-stage">
    <figure class="lo-portrait {{#if portrait.placeholder}}is-placeholder{{/if}}" aria-hidden="true">
      <img src="{{portrait.src}}" alt="" draggable="false"
           style="object-fit: {{portrait.fit}}; object-position: 50% {{portrait.focus}}%;">
      <div class="lo-vignette"></div>
    </figure>

    {{#if showName}}
    <header class="lo-nameplate">
      <h2 class="lo-name">{{name}}</h2>
    </header>
    {{/if}}

    {{!-- Hidden in play mode by CSS, from data-lo-mode (controller.mjs#refreshMode). --}}
    {{#if editable}}
    <button type="button" class="lo-portrait-config" data-lo-action="portrait"
            data-tooltip="{{localize "sogrom-simple-dnd5e-loadout.portrait.configure"}}"
            aria-label="{{localize "sogrom-simple-dnd5e-loadout.portrait.configure"}}">
      <i class="fa-solid fa-image-portrait" inert></i>
    </button>
    {{/if}}

    <div class="lo-column lo-column--left" role="group">
      {{#each groups.left}}{{> sogrom-lo-slot}}{{/each}}
    </div>

    <div class="lo-column lo-column--right" role="group">
      {{#each groups.right}}{{> sogrom-lo-slot}}{{/each}}
    </div>

    <div class="lo-hands" role="group">
      {{#each groups.hands}}{{> sogrom-lo-slot}}{{/each}}
    </div>

    {{!-- Camp clothes: a bordered group in the stage's empty middle column, so turning it on moves
          no other slot. Shown only when the GM enables camp clothes. --}}
    {{#if groups.camp.length}}
    <div class="lo-camp" role="group" aria-label="{{localize "sogrom-simple-dnd5e-loadout.slot.campGroup"}}"
         data-tooltip="{{localize "sogrom-simple-dnd5e-loadout.slot.campHint"}}">
      <span class="lo-camp-title" aria-hidden="true">
        <i class="fa-solid fa-campground" inert></i> {{localize "sogrom-simple-dnd5e-loadout.slot.campGroup"}}
      </span>
      {{#each groups.camp}}{{> sogrom-lo-slot}}{{/each}}
    </div>
    {{/if}}

    <div class="lo-picker-host"></div>
  </div>

  {{!-- One bar: light, instrument and tools first, then the trinkets. Kit leads so its slots stay
        where they are when the GM changes the trinket count. --}}
  {{#if showBar}}
  <div class="lo-trinkets" role="group" aria-label="{{localize "sogrom-simple-dnd5e-loadout.slot.barGroup"}}">
    {{#each groups.kit}}{{> sogrom-lo-slot}}{{/each}}
    {{#each groups.trinkets}}{{> sogrom-lo-slot}}{{/each}}
  </div>
  {{/if}}

  {{#if unslotted.length}}
  <section class="lo-unslotted">
    <h3 class="lo-subhead" data-tooltip="{{localize "sogrom-simple-dnd5e-loadout.unslotted.hint"}}">
      {{localize "sogrom-simple-dnd5e-loadout.unslotted.title"}}
      <i class="fa-solid fa-circle-info" inert></i>
    </h3>
    <ul class="lo-chips">
      {{#each unslotted}}
      <li>
        <button type="button" class="lo-chip rarity-{{rarity}}" data-lo-unslotted="{{id}}" data-lo-uuid="{{uuid}}"
                {{#if draggable}}draggable="true"{{/if}}
                data-tooltip="{{tooltip}}" data-tooltip-class="{{tooltipClass}}" aria-label="{{name}}"
                {{#if tooltipExtras}}data-tooltip-extras="{{tooltipExtras}}"{{/if}}>
          <img src="{{img}}" alt="" draggable="false">
          <span>{{name}}</span>
          {{#if warnings.length}}<i class="lo-chip-warning fa-solid fa-circle-exclamation" inert></i>{{/if}}
        </button>
      </li>
      {{/each}}
    </ul>
  </section>
  {{/if}}

  <footer class="lo-stats">
    {{#if sets}}
    <button type="button" class="lo-sets-button {{#if sets.current}}is-current{{/if}}" data-lo-action="sets"
            data-tooltip="{{sets.label}}" aria-label="{{sets.label}}" aria-haspopup="dialog">
      <i class="fa-solid fa-layer-group" inert></i>
      {{#if sets.current}}<span class="lo-sets-current">{{sets.current}}</span>{{/if}}
    </button>
    {{/if}}

    {{#if stats.ac includeZero=true}}
    <div class="lo-stat lo-stat--ac" data-tooltip="{{localize "sogrom-simple-dnd5e-loadout.stats.ac"}}">
      <i class="fa-solid fa-shield-halved" inert></i>
      <span class="lo-stat-value">{{stats.ac}}</span>
      <span class="lo-visually-hidden">{{localize "sogrom-simple-dnd5e-loadout.stats.ac"}}</span>
    </div>
    {{/if}}

    {{#if stats.attunement.pips.length}}
    <div class="lo-stat lo-stat--attunement {{#if stats.attunement.over}}is-over{{/if}}"
         data-tooltip="{{#if stats.attunement.over}}{{stats.attunement.overLabel}}{{else}}{{stats.attunement.label}}{{/if}}">
      <span class="lo-pips" aria-label="{{stats.attunement.label}}">
        {{#each stats.attunement.pips}}
        <span class="lo-pip {{#if filled}}is-filled{{/if}} {{#if over}}is-over{{/if}}"></span>
        {{/each}}
      </span>
    </div>
    {{/if}}

    {{#if stats.encumbrance}}
    <div class="lo-stat lo-stat--encumbrance band-{{stats.encumbrance.band}}"
         data-tooltip="{{localize "sogrom-simple-dnd5e-loadout.stats.encumbrance"}}: {{stats.encumbrance.label}}">
      <i class="fa-solid fa-weight-hanging" inert></i>
      <span class="lo-bar" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{stats.encumbrance.pct}}"
            aria-label="{{localize "sogrom-simple-dnd5e-loadout.stats.encumbrance"}}">
        <span class="lo-bar-fill" style="width: {{stats.encumbrance.pct}}%"></span>
      </span>
      <span class="lo-stat-value lo-stat-value--small">{{stats.encumbrance.label}}</span>
    </div>
    {{/if}}
  </footer>
</div>
